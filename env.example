# Gemini
GEMINI_API_KEY="your_gemini_api_key"

# Razorpay - NEVER expose the secret in VITE_* variables or frontend code.
# Get these from the Razorpay Dashboard. Start with Test Mode.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_test_secret"

# Used to sign FresherAI's verified premium entitlement token.
# Use a long random value (at least 32 characters) in production.
PAYMENT_TOKEN_SECRET="replace_with_a_long_random_secret"

# Optional canonical deployment URL.
APP_URL="http://localhost:3000"
